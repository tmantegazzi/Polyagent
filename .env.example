# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Polymarket Credentials
POLYMARKET_PRIVATE_KEY=your_ethereum_private_key_here
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Polymarket Network
CHAIN_ID=137
POLYMARKET_HOST=https://clob.polymarket.com

# Trading Mode
PAPER_TRADING=true

# Market to trade (token_id from Polymarket)
TARGET_TOKEN_ID=

# Risk Parameters
MAX_POSITION_SIZE_PCT=0.05
MIN_LIQUIDITY=50000
MAKER_REBATE_TARGET=0.001
COOLDOWN_PERIOD=600
MAX_DAILY_DRAWDOWN=0.05

# Market Making Parameters
BASE_SPREAD_PCT=0.02
CANCEL_REPLACE_INTERVAL_MS=1000
AI_UPDATE_INTERVAL_S=120

# Order Sizing
MIN_ORDER_SIZE=10
MAX_ORDER_SIZE=500
ORDER_LEVELS=3
